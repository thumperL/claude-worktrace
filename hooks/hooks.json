{
  "description": "Auto-capture worklogs, detect user steering patterns, and suggest setup retros",
  "hooks": {
    "PreCompact": [{
      "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre_compact_hook.py" }]
    }, {
      "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ledger_hook.py" }]
    }],
    "UserPromptSubmit": [{
      "matcher": "",
      "hooks": [{ "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre_clear_hook.sh" }]
    }],
    "SessionEnd": [{
      "hooks": [{ "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_end_wrapper.sh" }]
    }, {
      "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ledger_hook.py" }]
    }],
    "PostToolUse": [{
      "matcher": "Write",
      "hooks": [{ "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/memory_write_hook.sh" }]
    }]
  }
}
